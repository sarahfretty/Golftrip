# Security headers applied to every response by Cloudflare Pages.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Never cache the service worker or the app shell (so updates ship immediately).
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Fingerprinted assets can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
