{
  "name": "golftrips",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "comment:optionalDependencies": "Rolldown (Vite 8) native bindings, pinned per-platform so the correct one installs on macOS (local) and Linux (Cloudflare Pages) and the npm optional-deps bug can't skip it. Keep the version in step with the resolved rolldown version.",
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.1",
    "@rolldown/binding-linux-x64-gnu": "1.2.1"
  }
}
