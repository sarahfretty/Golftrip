# Copy to .env.local and fill in. NEVER commit real values — .env* is gitignored.
# In Cloudflare Pages, set these in the project's Environment Variables (Production + Preview).

# ── Supabase (shared backend) ────────────────────────────────
# Project settings → API. The anon key is safe to expose to the browser (RLS protects data).
# Leaving these blank runs the app on the local/offline adapter — fine for dev and demos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Organiser access (local adapter only) ────────────────────
# The shared PIN for the organiser console when running without Supabase Auth.
# In production, organisers sign in with Supabase Auth instead of this PIN.
VITE_ORGANISER_PIN=belek2026

# ── Seeding only — server-side, NEVER expose to the browser ───
# Used by `npm run db:seed`. Project settings → API → service_role key.
# Do not prefix with VITE_ (that would bundle it into the client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
